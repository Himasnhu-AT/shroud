---
import Base from '../layouts/Base.astro';
import Shot from '../components/Shot.astro';
import Plan from '../components/Plan.astro';
import Ticks from '../components/Ticks.astro';
import { home, difficulties, maps, gallery, facts, site } from '../data/site';
import geo from '../data/maps.json';
const ghostMax = 0.25;
---
<Base>
  <!-- 1. Scene: the live belief grid on Foundry -->
  <section class="hero" data-belief-scope aria-labelledby="hero-title">
    <div class="hero__map" data-belief data-map="foundry" data-mode="live" data-squad="4" data-seed="11" data-warm="4">
      <Plan map="foundry" title="Plan of Foundry, the map in the live illustration" />
      <canvas aria-hidden="true"></canvas>
    </div>
    <div class="hero__col">
      <div class="hero__text">
        <p class="hero__kind" data-split="lines" data-intro data-delay="0.2">{site.kind}</p>
        <h1 id="hero-title" class="hero__title" data-split="chars" data-intro>Shroud</h1>
        <p class="hero__line" data-split="lines" data-intro data-delay="0.45">{home.heroLine}</p>
        <div class="hero__act">
          <a class="btn target" href={home.heroCta.href} data-reveal="fade" data-intro data-delay="0.9"><span>{home.heroCta.label}</span><Ticks /></a>
          <p class="hero__hint" data-reveal="fade" data-intro data-delay="0.8"><span class="pip pip--you" aria-hidden="true"></span>{home.heroHint}</p>
        </div>
      </div>
      <div class="hero__lower">
        <figure class="hero__feed" data-reveal="clip" data-intro data-delay="0.35">
          <Shot src="firefight" alt="What the player sees on Foundry: red tracers over a low wall, an enemy at the right edge, and the kill feed showing Charlie reloading and Delta calling go." sizes="(max-width: 767px) 92vw, 22vw" widths={[400, 640, 960]} eager />
          <figcaption class="hero__feedcap">What you see</figcaption>
        </figure>
        <div class="hero__side" data-reveal="fade" data-intro data-delay="0.6">
          <p class="hero__maplabel">What they believe</p>
          <dl class="readout">
            <div><dt>Play</dt><dd data-readout="mode">Search</dd></div>
            <div><dt>Hottest cell</dt><dd data-readout="peak">H15</dd></div>
            <div><dt>Last seen</dt><dd data-readout="seen">now</dd></div>
          </dl>
          <ol class="radio" data-radio aria-hidden="true"></ol>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Statement -->
  <section class="statement" aria-labelledby="statement-title">
    <h2 id="statement-title" class="label">The match</h2>
    <p class="statement__text" data-split="lines">{home.statement}</p>
    <p class="statement__note">{home.statementNote}</p>
  </section>

  <!-- 3. Sticky narrative: the signature, chapter by chapter -->
  <section class="hunt" data-belief-scope data-belief-mode="belief" aria-labelledby="hunt-title">
    <div class="hunt__stage">
      <div class="hunt__map" data-belief data-map="foundry" data-mode="belief" data-squad="4" data-seed="5" data-warm="2">
        <Plan map="foundry" title="Plan of Foundry with the belief grid" />
        <canvas aria-hidden="true"></canvas>
      </div>
      <div class="hunt__hud">
        <dl class="readout">
          <div><dt>Play</dt><dd data-readout="mode">Watching</dd></div>
          <div><dt>Hottest cell</dt><dd data-readout="peak">I13</dd></div>
          <div><dt>Spread</dt><dd data-readout="spread">0 m</dd></div>
        </dl>
        <ol class="radio" data-radio aria-hidden="true"></ol>
      </div>
    </div>
    <div class="hunt__chapters">
      <h2 id="hunt-title" class="hunt__title">How they hunt you</h2>
      <p class="hunt__note">A sketch of the squad coordinator, running in your browser on the real Foundry plan. The game’s version is Rust.</p>
      {home.chapters.map((c, i) => (
        <article class="chapter" data-chapter={c.id === 'play' ? 'live' : c.id} aria-labelledby={`ch-${c.id}`}>
          <p class="chapter__n"><span>{i + 1}</span> of {home.chapters.length}</p>
          <h3 id={`ch-${c.id}`} class="chapter__title">{c.title}</h3>
          <p class="chapter__text">{c.text}</p>
          <p class="chapter__call"><span class="pip pip--squad" aria-hidden="true"></span>“{c.call}”</p>
        </article>
      ))}
      <a class="link-more target" href="/squad/"><span>The whole brain, play by play</span><Ticks /></a>
    </div>
  </section>

  <!-- 4. Data -->
  <section class="facts" aria-labelledby="facts-title">
    <div class="facts__head">
      <h2 id="facts-title" class="facts__title">{home.results.title}</h2>
      <p class="facts__lead">{home.results.lead}</p>
    </div>
    {home.results.items.map((r) => (
      <div class="fact" data-reveal="up">
        <h3 class="fact__label">{r.label}</h3>
        <p class="fact__after">{r.after}{r.unit && <span class="fact__unit">&nbsp;{r.unit}</span>}</p>
        <p class="fact__before">was {r.before}{r.unit && <>&nbsp;{r.unit}</>}</p>
        <p class="fact__note">{r.note}</p>
      </div>
    ))}
    <div class="fact fact--table" data-reveal="up">
      <h3 class="fact__label">{home.results.ghost.label}</h3>
      <table class="ghost">
        <caption class="fact__note">{home.results.ghost.note}</caption>
        <thead><tr><th scope="col">Map</th><th scope="col">Before</th><th scope="col">After</th></tr></thead>
        <tbody>
          {home.results.ghost.rows.map((r) => (
            <tr>
              <th scope="row">{r.map}</th>
              <td><span class="bar bar--before" style={`--w:${r.before / ghostMax}`} aria-hidden="true"></span>{r.before.toFixed(2)}</td>
              <td><span class="bar bar--after" style={`--w:${r.after / ghostMax}`} aria-hidden="true"></span>{r.after.toFixed(2)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- 5. Index: the maps -->
  <section class="maps" id="maps" aria-labelledby="maps-title">
    <h2 id="maps-title" class="label">Three maps, one rotates in each match</h2>
    <ul class="index" data-index>
      {maps.map((m) => (
        <li>
          <a class="index__row target" href={`/maps/${m.id}/`} data-preview={m.id}>
            <span class="index__name"><span>{m.name}</span><Ticks /></span>
            <span class="index__blurb">{m.blurb}</span>
            <span class="index__meta">{geo.maps.find((g) => g.id === m.id)!.zones.length} named zones</span>
            <span class="index__thumb"><Shot src={m.cover} alt="" sizes="40vw" widths={[480, 800]} /></span>
          </a>
        </li>
      ))}
    </ul>
    <div class="preview" aria-hidden="true">
      {maps.map((m) => (<div class="preview__img" data-for={m.id}><Shot src={m.cover} alt="" sizes="26vw" widths={[480, 800]} /></div>))}
    </div>
  </section>

  <!-- 6. Ladder: difficulty -->
  <section class="ladder" aria-labelledby="ladder-title">
    <div class="ladder__head">
      <h2 id="ladder-title" class="ladder__title">{home.difficulty.title}</h2>
      <p class="ladder__lead">{home.difficulty.lead}</p>
    </div>
    <ol class="ladder__list">
      {difficulties.map((d, i) => (
        <li class="rung" style={`--i:${i}`} data-reveal="up" data-delay={String(i * 0.06)}>
          <h3 class="rung__name">{d.name}</h3>
          <p class="rung__squad"><span class="sr-only">Squad of {d.squad}</span>
            {Array.from({ length: d.squad }, () => <span class="chev" aria-hidden="true"></span>)}
          </p>
          <p class="rung__blurb">{d.blurb}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- 7. Gallery wall: built in Rust -->
  <section class="build" aria-labelledby="build-title">
    <div class="build__text">
      <h2 id="build-title" class="build__title">{home.build.title}</h2>
      <p>{home.build.text}</p>
      <p>{home.build.engine}</p>
      <p class="build__port"><span class="build__num">{home.build.port.before}</span><span class="build__arrow" aria-hidden="true">→</span><span class="build__num build__num--after">{home.build.port.after}</span></p>
      <p class="build__portlabel">{home.build.port.label}</p>
    </div>
    <ul class="wall">
      {gallery.map((g, i) => (
        <li class={`wall__item wall__item--${i}`} data-reveal="clip">
          <figure>
            <Shot src={g.src} alt={g.alt} sizes="(max-width: 767px) 100vw, 40vw" widths={[480, 800, 1200]} />
            <figcaption>{g.caption}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </section>

  <!-- 8. Finale -->
  <section class="get" id="get" aria-labelledby="get-title">
    <p class="get__pre">No matches yet.</p>
    <h2 id="get-title" class="get__title" data-split="words">{home.get.title}</h2>
    <p class="get__note">{home.get.note}</p>
    <dl class="get__list">
      {facts.map((r) => (<div><dt>{r.label}</dt><dd>{r.value}</dd></div>))}
    </dl>
    <p class="get__pending"><span class="pip pip--squad" aria-hidden="true"></span>{home.get.pending}</p>
  </section>
</Base>
