---
// The map plan as static SVG, from the real geometry. It is what no-JS visitors and crawlers
// get; with JS the live canvas draws the same plan with the belief grid on top.
import data from '../data/maps.json';
interface Props { map?: string; zones?: boolean; spawns?: boolean; title?: string }
const { map = 'foundry', zones = false, spawns = false, title } = Astro.props;
const m = data.maps.find((x) => x.id === map)!;
// Maps differ in size: each has its own half extent (older exports had one shared value).
const H: number = (m as { half?: number }).half ?? (data as { half?: number }).half ?? 32;
// The same ~4 m cells as the live belief grid (src/motion/belief.ts).
const bw = Math.max(1, Math.round((H * 2) / 4));
const cells = Array.from({ length: bw + 1 }, (_, i) => -H + (i * H * 2) / bw);
// Labels are 1.15 m type (about 0.55 m per character); skip one wider than its zone.
const fits = (z: { name: string; x0: number; x1: number }) => z.name.replace(/^the /, '').length * 0.55 <= (z.x1 - z.x0) * 1.1;
const skip = new Set(['the cubicles', 'the south spawn', 'the north spawn', 'attacker spawn', 'defender spawn']);
---
<svg class="plan" viewBox={`${-H} ${-H} ${H * 2} ${H * 2}`} role="img" aria-label={title ?? `Plan of ${m.label}`}>
  <g class="plan__grid">
    {cells.map((v) => <line x1={v} y1={-H} x2={v} y2={H} />)}
    {cells.map((v) => <line x1={-H} y1={v} x2={H} y2={v} />)}
  </g>
  <rect class="plan__edge" x={-H + 1} y={-H + 1} width={H * 2 - 2} height={H * 2 - 2} />
  {m.blocks.filter((b) => b.kind !== 'Wall').map((b) => (
    <rect class={b.kind === 'Tall' ? 'plan__tall' : 'plan__low'} x={b.x - b.hx} y={b.y - b.hy} width={b.hx * 2} height={b.hy * 2} />
  ))}
  {zones && m.zones.filter((z) => !skip.has(z.name) && fits(z)).map((z) => (
    <text class="plan__zone" x={(z.x0 + z.x1) / 2} y={(z.y0 + z.y1) / 2}>{z.name.replace(/^the /, '')}</text>
  ))}
  {spawns && m.enemySpawns.map((p, i) => (
    <g class="plan__spawn"><rect x={p[0] - 1.2} y={p[1] - 1.2} width="2.4" height="2.4" /><text x={p[0]} y={p[1]}>{i + 1}</text></g>
  ))}
  {spawns && <circle class="plan__you" cx={m.playerSpawn[0]} cy={m.playerSpawn[1]} r="1" />}
</svg>
