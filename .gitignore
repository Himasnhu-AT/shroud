/target
.DS_Store

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
.claude/worktrees/
graft/.cache/
/dist

# Generated from Epic MetaHuman DNA (MetaHuman license, not CC0): see scripts/make-metahuman.sh
/assets/models/metahuman/
/scripts/metahuman/Saved/
/scripts/metahuman/Intermediate/
/scripts/metahuman/DerivedDataCache/

# Imported photoscan sets (assets/library, engine assets.py): only the cooked KTX2, color.avg and
# material.json are committed; the source maps stay local (re-import from the URL in CREDITS.md).
/assets/library/textures/**/*.jpg
/assets/library/textures/**/*.png
/assets/library/decals/**/*.jpg
/assets/library/decals/**/*.png

# Fab downloads (assets/library/*/ms-* Megascans, */fab-* other sellers), imported with the engine's
# assets.py: Fab's Standard License forbids redistributing them, so none of their files is
# committed (source maps, cooked KTX2, LOD GLBs). Only their LICENSES.json entries and CREDITS.md
# rows are. Foundry falls back to the CC0 stand-ins without them (docs/ASSETS.md).
/assets/library/*/ms-*/
/assets/library/*/fab-*/

# Gun packs under a no-redistribution licence (Fab / Sketchfab Standard): local only.
/assets/models/weapons/hd/

# Fab Standard (Personal) guns and outfits: not redistributable; local only, ledger committed.
/assets/library/misc/
/assets/library/characters/
/assets/models/gear/
